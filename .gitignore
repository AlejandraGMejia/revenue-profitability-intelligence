# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Python build artifacts
build/
dist/
*.egg-info/

# Environment variables and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Local databases
*.db
*.sqlite
*.sqlite3

# Raw and processed datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# dbt artifacts
target/
dbt_packages/
logs/

# Generated investigation datasets
reports/sales_discrepancies.csv

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.bak
*.swp

# ==================================================
# END
